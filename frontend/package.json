{
  "name": "pumlv-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "fetch:plantuml": "node scripts/fetch-plantuml-core.mjs",
    "build": "node scripts/fetch-plantuml-core.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "oxlint src",
    "fmt": "oxfmt --write src",
    "fmt:check": "oxfmt --check src",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@hpcc-js/wasm": "^2.20.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-zoom-pan-pinch": "^3.7.0",
    "shiki": "^1.29.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@playwright/test": "^1.49.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^25.0.0",
    "oxfmt": "^0.49.0",
    "oxlint": "^1.10.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
