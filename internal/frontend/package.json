{
  "name": "pumlv-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.0.8",
  "scripts": {
    "dev": "vite",
    "vendor:plantuml": "node scripts/vendor-plantuml-core.mjs",
    "credits": "node scripts/generate-frontend-credits.mjs",
    "build": "node scripts/vendor-plantuml-core.mjs && node scripts/generate-frontend-credits.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "oxlint src",
    "fmt": "oxfmt --write src",
    "fmt:check": "oxfmt --check src",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "screenshots": "node scripts/screenshots.mjs",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-zoom-pan-pinch": "^4.0.3",
    "shiki": "^4.2.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@plantuml/core": "^1.2026.6",
    "@playwright/test": "1.61.1",
    "@rolldown/plugin-babel": "^0.2.0",
    "@storybook/addon-vitest": "10.5.3",
    "@storybook/react-vite": "10.5.3",
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "babel-plugin-react-compiler": "^1.0.0",
    "jsdom": "^29.1.1",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.76.0",
    "playwright": "1.61.1",
    "storybook": "10.5.5",
    "tailwindcss": "^4.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
